<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Required so the app can send Apple Events (control Music) while running under
    the Hardened Runtime, which notarization requires. This does NOT grant access
    on its own — the user is still shown the Automation consent prompt (with our
    NSAppleEventsUsageDescription) the first time.
  -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
